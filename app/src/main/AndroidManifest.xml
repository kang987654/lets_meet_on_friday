<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 모델 다운로드 전경 작업용 (ADR-006). 알림 권한이 거부되어도 다운로드는 계속 진행된다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 리마인더 정확 알람용 (B1). 권한이 없으면 ±10분 창으로 자동 강등되고,
         재부팅 복원(BOOT_COMPLETED)은 AlarmManager 가 재부팅에 살아남지 않는 대가다. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- [WHY] targetSdk 30+ 패키지 가시성 — 이 선언이 없으면 TextToSpeech.getEngines() 가 비어 엔진(삼성·구글)을 고를 수 없다 (0.29.0). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".KosmosApp"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <!-- [WHY] singleTop — 기본(standard)이면 위젯·타일·알림의 재진입이 액티비티를 재생성해
             onNewIntent 를 타지 않는다. 인텐트에도 FLAG_ACTIVITY_SINGLE_TOP 이 짝으로 필요. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- FileProvider for sharing export ZIP files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- [WHY] KosmosApp 이 Configuration.Provider 로 HiltWorkerFactory 를 제공하는
             on-demand 초기화를 쓰므로, androidx.startup 의 기본 WorkManager 초기화를 제거한다.
             남겨두면 기본 팩토리가 먼저 잡혀 @HiltWorker 주입이 실패한다. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- 전경 서비스 타입 선언 (API 34+ 필수) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- 홈 위젯 (A3) — 오늘 일정·할 일, 추론 없음 -->
        <receiver
            android:name=".widget.KosmosWidgetReceiver"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_kosmos_info" />
        </receiver>

        <!-- 리마인더 알람 발화 — 명시적 PendingIntent 전용이므로 intent-filter 없음 (B1) -->
        <receiver
            android:name=".platform.alarm.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- 재부팅 후 알람 복원 — 시스템 보호 브로드캐스트는 exported=false 로도 수신된다 -->
        <receiver
            android:name=".platform.alarm.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- QS 타일 — 음성 입력으로 열기 (A3, PTT) -->
        <service
            android:name=".platform.tile.VoiceTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/tile_voice_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
